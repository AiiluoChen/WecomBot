# --- LLM API 配置 ---
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# --- 服务配置 ---
PORT=8000
HOST=0.0.0.0

# --- 数据源配置 ---
CSV_DATA_PATH=data/photo_delivery.csv

# --- 企业微信官方接口配置 (用于外部客户真实聊天 / 消息解密 / 转人工) ---
WECOM_CORP_ID=your_corp_id
WECOM_KF_SECRET=your_kf_secret
WECOM_TOKEN=your_token
WECOM_ENCODING_AES_KEY=your_encoding_aes_key
WECOM_DEFAULT_SERVICER=your_servicer_userid

# --- 阿里云服务器自动化部署配置 (可选，用于 ./deploy.sh 自动远程部署) ---
ALIYUN_SERVER_IP=your_aliyun_ip_here
